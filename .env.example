# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/belwara

# ── Azure OpenAI (v1 API) ────────────────────────────────────────────────────
# Endpoint of the Azure OpenAI / AI Foundry resource, without /openai/v1.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# Deployment names (not model names). One deployment can serve both if the model
# supports vision, structured outputs and tool calling.
RECEIPT_DEPLOYMENT=
CHAT_DEPLOYMENT=

# ── Receipt file storage ─────────────────────────────────────────────────────
# Leave empty in local dev to store files under RECEIPTS_IMG_DIR.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=receipts
RECEIPTS_IMG_DIR=receipts_img

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
CURRENCYFREAKS_API_KEY=
# Comma-separated frontend origins, e.g. http://localhost:3000
CORS_ORIGINS=http://localhost:3000
